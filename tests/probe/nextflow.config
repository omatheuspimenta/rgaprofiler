// Loads the pipeline's REAL base.config (the thing under test), with just the params it reads.
params {
    use_gpu         = 'false'   // sizing tests never touch a GPU or the lock; see test_gpu_lock.sh for that
    gpu_concurrency = null
    deeptmhmm_cpu_threads = null
    chunk           = null
}
includeConfig '../../conf/base.config'

// So nf-test's `-profile test` (tests/resources.nf.test) applies the same tight
// resourceLimits (4 CPUs / 15GB) a real CI run of the pipeline gets from conf/test.config.
profiles {
    test { includeConfig '../../conf/test.config' }
}
