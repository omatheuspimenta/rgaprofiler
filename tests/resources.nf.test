nextflow_pipeline {

    name "Per-chunk resource sizing"
    script "./probe/main.nf"
    config "./probe/nextflow.config"
    tag "resources"
    tag "no_licensed_software" // runs in CI: no softwares/ needed (see .github/workflows/nf-test.yml)

    // Runs the REAL conf/base.config's process_medium_chunk / process_high_chunk labels
    // (through tests/probe/, no containers or GPU needed) under the small-CI-machine
    // limits of conf/test.config, and checks the auto-scaled requests degrade gracefully:
    // never more than the limits (a task requesting more than the host can provide would
    // never be admitted), and no worse than the old fixed requests. The large-host,
    // tiny-host, resourceLimits and GPU-lock behaviour are covered by mocked-host tests
    // in tests/bin/ (they need to fake /proc/meminfo, nproc and nvidia-smi, which
    // nf-test cannot do); see tests/bin/test_*.sh.
    test("-profile test: chunk labels stay within CI-sized resourceLimits") {

        when {
            params {
                chunk = "${projectDir}/tests/testdata/r570_subsample.fasta"
            }
        }

        then {
            assert workflow.success
            def lines = workflow.stdout.findAll { it.startsWith('CHUNK_') }
            assert lines.size() == 2
            lines.each { line ->
                def cpus   = (line =~ /cpus=(\d+)/)[0][1] as int
                def mem_gb = (line =~ /mem_gb=(\d+)/)[0][1] as int
                // conf/test.config: cpus 4, memory 15.GB
                assert cpus   >= 1 && cpus   <= 4  : "cpus ${cpus} exceeds test resourceLimits: ${line}"
                assert mem_gb >= 1 && mem_gb <= 15 : "memory ${mem_gb}GB exceeds test resourceLimits: ${line}"
            }
        }
    }
}
