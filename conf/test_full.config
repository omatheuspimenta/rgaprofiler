/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run omatheuspimenta/rgaprofiler -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    // Input data for full size test: the real, full R570 proteome (299,731 sequences),
    // referenced (not copied) from softwares/data_test/ -- requires that directory to be
    // populated per docs/software-setup.md; not committed to git (softwares/ is gitignored).
    // Opt-in, full-scale run validated against the real R570 tool outputs under softwares/*/r570*.
    input = "${projectDir}/tests/testdata/samplesheet_full.csv"
}
