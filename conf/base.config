/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    omatheuspimenta/rgaprofiler Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    // TODO nf-core: Check the defaults for all processes
    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // TODO nf-core: Customise requirements for specific processes.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_low_memory {
        memory = { 1.GB * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    // ------------------------------------------------------------------------------
    // Per-chunk labels: DeepCoil2, DeepLoc2, SignalP6, DeepTMHMM (process_medium_chunk) and
    // InterProScan (process_high_chunk) each run once per FASTA_QC chunk (see
    // workflows/rgaprofiler.nf), not once per proteome, so one task only ever holds one
    // chunk's worth of sequences. These labels size for THAT execution model -- the
    // generic process_medium/process_high above are for whole-input processes such as
    // RGA_CLASSIFY.
    //
    // Every request is computed per task, from what is actually in that chunk
    // (task.ext.chunk: sequences, residues, longest protein -- see below), from the tool
    // (per-tool coefficients, in the withName blocks further down) and, on the `local`
    // executor, from the host (task.ext.host). None of this changes any tool's output:
    // only what is reserved/allowed, never how a tool is invoked (exceptions -- thread
    // counts that were verified output-neutral -- are called out where they occur).
    //
    //   memory = (ext.mem_gb + ext.mem_gb_per_mib * chunk FASTA MiB) * task.attempt
    //     What drives memory was measured, not assumed (peak RSS from the trace of a real
    //     1000-chunk R570 run, joined to each chunk's own composition, plus single proteins
    //     of 1k-35k residues through the whole pipeline, GPU and CPU mode):
    //       tool          300-seq chunk   4913-seq chunk   one 35k-residue protein
    //       SignalP6      3.1-3.6GB       4.3GB            3.5GB (1.9GB on CPU)
    //       DeepTMHMM     5.4-5.5GB       5.5GB            5.4GB
    //       DeepLoc2      9.9-10.3GB      10.3GB           10.0GB (10.3GB on CPU)
    //       DeepCoil2     5.7-6.8GB       16.0GB           5.0GB
    //       InterProScan  4.5-7.8GB       ~13-14GB (extr.) 6.0GB
    //     i.e. model-bound: nearly flat in protein length (these tools truncate or window
    //     long proteins), and only DeepCoil2 and InterProScan grow with how much is in the
    //     chunk -- which chunk FASTA size tracks. The coefficients below keep >=25% headroom
    //     over every figure above. Previously all four GPU-capable tools shared one
    //     14GB + 3.5GB/MiB rule, reserving ~4x what SignalP6 uses -- which, once they share
    //     a GPU, parks RAM that InterProScan chunks could be using.
    //   time = task.attempt * max(8h, 5 * (60s + ext.sec_per_kres[gpu|cpu] * kilo-residues))
    //     Throughput per 1000 residues, measured per device; the 5x absorbs slower hosts
    //     and contention. The 8h floor is the previous fixed limit, so only big chunks get
    //     more (e.g. SignalP6 on CPU needs ~7h for one 5000-sequence chunk here -- right at
    //     the old 8h wall). -profile long_running still replaces this with its fixed days.
    //   `* task.attempt` keeps the standard retry-with-more-memory/time behaviour.
    //   On the `local` executor requests are capped at what the host can ever provide
    //   (90% of its RAM; its CPU count): a task asking for more than the machine has can
    //   never be admitted. Explicit user limits still win: process.resourceLimits (see
    //   conf/test.config) is applied by Nextflow on top of whatever these closures return.
    // ------------------------------------------------------------------------------
    withLabel:process_medium_chunk {
        cpus   = {
            def want = task.ext.cpus_cpu_mode && !task.ext.use_gpu ? task.ext.cpus_cpu_mode : (task.ext.use_gpu ? 4 : 6)
            task.ext.host.local ? Math.min(want as int, task.ext.host.cpus) : want
        }
        memory = {
            def gb = ((task.ext.mem_gb ?: 14) + (task.ext.mem_gb_per_mib ?: 3.5) * fasta.size() / (1024 * 1024)) * task.attempt as double
            def cap = task.ext.host.local ? Math.max(1d, Math.floor(task.ext.host.mem_gb * 0.9d)) : gb
            (Math.ceil(Math.min(gb, cap)) as int).GB
        }
        time   = {
            def rate = task.ext.sec_per_kres ? task.ext.sec_per_kres[task.ext.use_gpu ? 'gpu' : 'cpu'] : null
            def est = rate ? 5 * (60 + rate * task.ext.chunk.residues / 1000d) : 0d
            (Math.max(8 * 3600d, est) * task.attempt as long).s
        }
    }
    withLabel:process_high_chunk {
        // InterProScan's `-cpu N` is only an upper bound on its worker threads: on a real
        // 1000-chunk run its measured CPU use was median 3.1 cores (p95 3.7, max 4.1), and
        // one real 300-sequence chunk ran no slower at `-cpu 4` (20m01s) than at `-cpu 6`
        // (20m21s/25m39s), with the same result rows. (Row ORDER in InterProScan's TSV
        // varies from run to run even at the same -cpu, so it was never fixed anyway.)
        // Memory: that run's peak RSS was median 6.4GB, p99 7.6GB, max 7.8GB (8.8GB in an
        // earlier 1000-chunk run) against the 11.5GB it reserved -- which, not CPUs, is
        // what capped it at 39 concurrent tasks on a 503GB host. A 10GB floor (10.5GB at
        // that chunk size) keeps ~19% headroom over the worst seen; an OOM still retries
        // with double the memory (errorStrategy above). Long proteins barely matter (6.0GB
        // for a single 35k-residue protein).
        cpus   = {
            def want = 4
            task.ext.host.local ? Math.min(want, task.ext.host.cpus) : want
        }
        memory = {
            def gb = (10 + 2.5 * fasta.size() / (1024 * 1024)) * task.attempt as double
            def cap = task.ext.host.local ? Math.max(1d, Math.floor(task.ext.host.mem_gb * 0.9d)) : gb
            (Math.ceil(Math.min(gb, cap)) as int).GB
        }
        // ~10.3s per 1000 residues on 4 CPUs for typical proteins, ~17s for very long ones.
        time   = { (Math.max(16 * 3600d, 5 * (60 + 18 * task.ext.chunk.residues / 1000d)) * task.attempt as long).s }
    }

    // What is in this task's chunk: number of sequences, total residues and the longest
    // protein, read from the task's `fasta` input (so only for processes whose chunk
    // input is named `fasta`). Memoized per file in a JVM system property -- several
    // directives read it for every chunk task, and a file's content never changes.
    // In a directive, `fasta` is Nextflow's staged-name wrapper (TaskPath): its toString()
    // is just the file name and it can't be read directly (ProviderMismatchException), so
    // both the key and the read use the real file behind it.
    ext.chunk = {
        def src = fasta.hasProperty('target') ? fasta.target : fasta
        def key = 'rgaprofiler.chunk:' + src.toUriString()
        def raw = System.getProperty(key)
        if (raw == null) {
            def s = [seqs: 0L, residues: 0L, longest: 0L, cur: 0L]
            src.eachLine { line ->
                if (line.startsWith('>')) { s.longest = Math.max(s.longest, s.cur); s.cur = 0L; s.seqs += 1 }
                else { def k = line.trim().length(); s.cur += k; s.residues += k }
            }
            s.longest = Math.max(s.longest, s.cur)
            raw = "${s.seqs},${s.residues},${s.longest}".toString()
            System.setProperty(key, raw)
        }
        def v = raw.tokenize(',').collect { x -> x as long }
        [seqs: v[0], residues: v[1], longest: v[2]]
    }

    // Live host resources (CPUs, RAM, GPUs/VRAM), for the labels above. Same lazy,
    // per-task design as ext.use_gpu below, and for the same reason (see the long comment
    // there): it must reflect the host the pipeline is actually running on, which a value
    // precomputed into params.* at config-parse time does not reliably do. It is only
    // *evaluated* by tasks that read task.ext.host, so other processes never pay for it.
    // The probe result is memoized in a JVM system property for the life of the run --
    // total CPUs/RAM/VRAM of a host don't change mid-run, and Nextflow evaluates each
    // directive closure once per task, so ~thousands of chunk tasks would otherwise
    // each fork a probe. `local` is only true for the `local` executor: under a grid/cloud
    // scheduler the launch host is not the machine a task runs on, so nothing here is
    // used to shrink requests there (fixed per-chunk defaults apply instead).
    ext.host = {
        def raw = System.getProperty('rgaprofiler.host_resources')
        if (raw == null) {
            def probe = ["bash", "${projectDir}/bin/detect_host_resources.sh"].execute()
            raw = probe.text
            raw = probe.waitFor() == 0 ? raw : ''
            System.setProperty('rgaprofiler.host_resources', raw)
        }
        def h = [:]
        raw.readLines().each { line ->
            def kv = line.split('=', 2)
            if (kv.size() == 2 && kv[1].trim().isInteger()) { h[kv[0].trim()] = kv[1].trim() as int }
        }
        [
            local  : task.executor == 'local' && (h.cpus ?: 0) > 0 && (h.mem_gb ?: 0) > 0,
            cpus   : h.cpus ?: 1,
            mem_gb : h.mem_gb ?: 1,
            gpus   : h.gpus ?: 0,
            vram_mb: h.gpu_vram_mb ?: 0,
        ]
    }

    // GPU usage (params.use_gpu: 'auto'/'true'/'false' -- see docs/software-setup.md) is
    // resolved right here, per-task, at directive-evaluation time -- NOT precomputed once
    // into a params.* value by PIPELINE_INITIALISATION as an earlier version of this file
    // did. That earlier design silently never worked: Nextflow process-directive closures
    // read the `params` binding as it stood when the config was parsed, not later runtime
    // mutations made from inside a workflow/subworkflow script (confirmed empirically --
    // `workflow { params.x = true }` is invisible to a `{ params.x == true }` directive
    // closure even though it looks like it should update the same object). Calling
    // bin/detect_gpu.sh directly inside the closure below sidesteps that entirely: the
    // closure is genuinely lazy and re-run per GPU-labelled task, so it always reflects
    // the live params.use_gpu value and the actual host. containerOptions is scoped to
    // only this label so non-GPU processes are never handed a --gpus/--nv flag their
    // container doesn't need.
    //
    // Every params.use_gpu / params.gpu_concurrency comparison below goes through
    // toString(): the same setting reaches here as a String from the CLI
    // (`--use_gpu false`, `--gpu_concurrency 0`) but as a Boolean/Integer from an
    // unquoted -params-file value (`use_gpu: false`), and `false == 'false'` is false in
    // Groovy -- which silently kept GPU tasks serialized by maxForks on a CPU-only run
    // (or ignored an unquoted `use_gpu: true`). workflows/rgaprofiler.nf's SignalP6 weight
    // selection resolves use_gpu the same way.
    withLabel: process_gpu {
        ext.use_gpu      = {
            if (params.use_gpu.toString() == 'auto') {
                def gpu_probe = ["bash", "${projectDir}/bin/detect_gpu.sh"].execute()
                gpu_probe.waitFor() == 0
            } else {
                params.use_gpu.toString() == 'true'
            }
        }
        accelerator      = { task.ext.use_gpu ? 1 : null }
        // `-e CUDA_VISIBLE_DEVICES -e CUDA_DEVICE_ORDER` (no value) makes docker forward
        // whatever the beforeScript below exported for the GPU slot this task won
        // (singularity/apptainer inherit the host environment on their own).
        containerOptions = {
            if (!task.ext.use_gpu) return ''
            workflow.containerEngine in ['singularity', 'apptainer'] ? '--nv' : '--gpus all -e CUDA_VISIBLE_DEVICES -e CUDA_DEVICE_ORDER'
        }

        // GPU exclusivity. The `accelerator` directive above is only honoured by
        // grid/cloud schedulers (Slurm, Kubernetes, AWS/Google Batch, ...) -- the `local`
        // executor has no concept of a GPU "slot" and would happily launch every
        // process_gpu-labelled task at once. DeepCoil2, DeepLoc2, SignalP6 and DeepTMHMM
        // are four independent branches of the DAG, and each runs once per chunk, so
        // that means hundreds of tasks hitting one physical card (a real CUDA OOM
        // risk, not just slowness). Two pieces prevent it, and neither touches the
        // CPU/memory admission budget -- an earlier version faked a GPU lock by having
        // every GPU task request 75% of the host's CPUs, which starved indefinitely as
        // soon as InterProScan's many small CPU tasks kept refilling freed capacity:
        //   1. beforeScript sources bin/gpu_lock.sh, a real host-level flock semaphore
        //      (see that file for the semantics), held for the whole task. By default it
        //      is VRAM-weighted: a task holds as much of the card as its tool's measured
        //      peak VRAM (ext.gpu_vram_mb, set per tool below), so light tools share one
        //      GPU while their summed peaks still fit -- 1 task per GPU whenever the VRAM
        //      can't be read. `--gpu_concurrency N` instead allows exactly N tasks of any
        //      tool per GPU; 0 disables the lock, for schedulers that already allocate
        //      GPUs to jobs. Only applied on the `local` executor.
        //   2. maxForks caps how many tasks PER PROCESS are admitted at once to the number
        //      of slots, so with --num_blocks 1000 you don't get 1000 tasks admitted, each
        //      reserving CPUs and RAM while sitting idle on the lock. (Nextflow can only
        //      hold `maxForks` as a static value, not a per-task closure, so -- unlike
        //      everything above -- it is evaluated once, when this config is parsed, by
        //      bin/gpu_max_forks.sh: no cap when GPU is off, forced off, or `auto` finds
        //      no GPU; otherwise how many of that process's tasks fit, per tool below.)
        beforeScript = {
            (task.ext.use_gpu && task.executor == 'local' && params.gpu_concurrency?.toString() != '0') ?
                "source ${projectDir}/bin/gpu_lock.sh ${params.gpu_concurrency ?: 'auto'} ${task.ext.gpu_vram_mb ?: ''}" : ''
        }
        maxForks = (["bash", "${projectDir}/bin/gpu_max_forks.sh", "${params.use_gpu}", "${params.gpu_concurrency}"].execute().text.trim() ?: null) as Integer
    }

    // Per-tool sizing for the four GPU-capable chunk tools (see the per-chunk labels at
    // the top of this file for how each value is used, and the measurements behind them).
    //   mem_gb / mem_gb_per_mib  host RAM: floor + slope per MiB of chunk FASTA
    //   sec_per_kres             throughput per 1000 residues, GPU and CPU mode (sets `time`)
    //   gpu_vram_mb              peak VRAM for the VRAM-weighted GPU lock (process_gpu, above):
    //                            nvidia-smi peak memory.used with the tool alone, CUDA context
    //                            included, plus ~15% headroom. SignalP6 (1.9GB) and DeepLoc2
    //                            (3.1GB) are flat -- they truncate long proteins. DeepTMHMM
    //                            grows linearly with the chunk's longest protein (3.7GB at 2.5k
    //                            residues, 5.6GB at 10k, 8.0GB at 20k, 11.7GB at 35k: ~3.1GB +
    //                            0.25MB/residue), so its need is computed per chunk. DeepCoil2
    //                            grows with both length and sequence count (3.3GB at one 2.5k
    //                            protein ... 15.7GB at one 20k protein; 9.9GB for 300 sequences,
    //                            19.2GB for 4913), so it always takes a whole GPU ('all').
    //                            `maxForks` is computed once, for a typical chunk; a chunk that
    //                            needs more simply holds more of the lock.
    // Sharing the card this way leaves every tool's output unchanged: the same chunk run
    // alone vs. alongside the others (and DeepTMHMM x3) gave identical results for all
    // four tools.
    withName: 'SIGNALP6$' {
        ext.mem_gb          = 4.5
        ext.mem_gb_per_mib  = 0.3
        ext.sec_per_kres    = [gpu: 0.5, cpu: 12]
        // SignalP6 runs 8 torch threads (+8 output writers) whatever it is given (its
        // --torch_num_threads/--write_procs defaults), so reserve what it really uses.
        ext.cpus_cpu_mode   = 8
        ext.gpu_vram_mb     = 2200
        maxForks = (["bash", "${projectDir}/bin/gpu_max_forks.sh", "${params.use_gpu}", "${params.gpu_concurrency}", "2200"].execute().text.trim() ?: null) as Integer
    }
    withName: 'DEEPLOC2$' {
        ext.mem_gb          = 12.5
        ext.mem_gb_per_mib  = 0.3
        ext.sec_per_kres    = [gpu: 0.5, cpu: 8]
        ext.gpu_vram_mb     = 3600
        maxForks = (["bash", "${projectDir}/bin/gpu_max_forks.sh", "${params.use_gpu}", "${params.gpu_concurrency}", "3600"].execute().text.trim() ?: null) as Integer
    }
    withName: 'DEEPTMHMM$' {
        ext.mem_gb          = 8        // 5.4GB on GPU, 6.5GB on CPU for a 300-sequence chunk
        ext.mem_gb_per_mib  = 0.3
        // CPU: with predict.py's own thread count (below) one 300-protein chunk took 383s
        // on a 24-core host but ~3.75h on this 256-core one (torch collapses at 256 threads
        // for its one-protein-at-a-time work), so the CPU rate is that worst case.
        ext.sec_per_kres    = [gpu: 3, cpu: params.deeptmhmm_cpu_threads ? 8 : 100]
        // predict.py sets torch's thread count to os.cpu_count() -- every core of the host,
        // whatever the task was given -- and changing that changes the published embeddings
        // (bitwise; predictions stay identical). So by default nothing lowers it on CPU;
        // instead, on the `local` executor each CPU-mode DeepTMHMM task reserves the whole
        // host, so two of them never oversubscribe it (~8x slower per chunk when 4 ran at
        // once on a simulated 24-core host, vs. 383s for one alone). Grid executors are left
        // as they were. --deeptmhmm_cpu_threads N opts into capping it to N (module
        // modules/local/deeptmhmm), and then reserves just those N.
        ext.cpu_threads     = params.deeptmhmm_cpu_threads ?: null
        ext.cpus_cpu_mode   = { params.deeptmhmm_cpu_threads ? (params.deeptmhmm_cpu_threads as int) : (task.ext.host.local ? task.ext.host.cpus : 6) }
        ext.gpu_vram_mb     = { Math.ceil(1.15 * (3100 + 0.25 * task.ext.chunk.longest)) as long }
        maxForks = (["bash", "${projectDir}/bin/gpu_max_forks.sh", "${params.use_gpu}", "${params.gpu_concurrency}", "4600"].execute().text.trim() ?: null) as Integer
    }
    withName: 'DEEPCOIL2$' {
        ext.mem_gb          = 7.5
        ext.mem_gb_per_mib  = 3.5
        ext.sec_per_kres    = [gpu: 2, cpu: 8]
        ext.gpu_vram_mb     = 'all'
        maxForks = (["bash", "${projectDir}/bin/gpu_max_forks.sh", "${params.use_gpu}", "${params.gpu_concurrency}", "all"].execute().text.trim() ?: null) as Integer
    }
}
