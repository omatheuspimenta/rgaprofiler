/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run omatheuspimenta/rgaprofiler -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data: 4 real R570 sequences (tests/testdata/r570_subsample.fasta), hand-picked
    // (not random) from softwares/data_test/SofficinarumxspontaneumR570_771_v2.1.protein.fa
    // for known-positive coverage across tools -- see tests/testdata/README.md for exactly
    // which sequence covers which tool and why.
    input = "${projectDir}/tests/testdata/samplesheet_test.csv"
}
