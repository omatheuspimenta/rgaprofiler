/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // Every result is published as <outdir>/<tool>/<sample>/<file>. The sample level keeps
    // the samples of a multi-sample run apart -- without it, same-named files (every
    // rga_predictions.tsv, SignalP6's region_output.gff3, DeepTMHMM's summaries, ...)
    // overwrote each other, keeping only the last sample's. A module's own staging
    // directory (results/, rga_out/, report_out/) is not repeated in the published path:
    // when a module emits that directory, Nextflow hands saveAs only the directory itself
    // (not the files inside it), so the directory is published AS the sample folder;
    // files emitted individually from inside it go into the sample folder directly.
    // <tool> is the first underscore-token of the process name (DEEPCOIL2_MERGE ->
    // deepcoil2), so each tool's *_MERGE lands where an unchunked run would have.
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename ->
            filename.equals('versions.yml') ? null :
                filename in ['results', 'rga_out', 'report_out'] ? "${meta.id}" :
                    "${meta.id}/" + filename.replaceFirst(/^(results|rga_out|report_out)\//, '')
        }
    ]

    // RGA_CLASSIFY and RGA_REPORT would both tokenize to "rga" -- the report gets its own
    // top-level directory.
    withName: 'RGA_REPORT' {
        publishDir = [
            path: { "${params.outdir}/summary_report" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.equals('versions.yml') ? null :
                    filename in ['results', 'rga_out', 'report_out'] ? "${meta.id}" :
                        "${meta.id}/" + filename.replaceFirst(/^(results|rga_out|report_out)\//, '')
            }
        ]
    }

    // DEEPCOIL2, PHOBIUS, INTERPROSCAN, DEEPLOC2, SIGNALP6 and DEEPTMHMM all run once per
    // FASTA_QC chunk rather than once per sample (see workflows/rgaprofiler.nf), so
    // every chunk of the same sample shares the same meta.id and would otherwise all
    // publish as the identical filename under the generic rule above, repeatedly
    // overwriting each other. These per-chunk outputs are a pure intermediate --
    // disable publishing for them; each tool's own *_MERGE process (whose name also
    // tokenizes to the same first token, e.g. "DEEPCOIL2_MERGE" -> "deepcoil2", so it
    // lands at the exact same path the single unchunked process used to) publishes the
    // real, merged deliverable instead.
    withName: 'DEEPCOIL2$' {
        publishDir = [ enabled: false ]
    }
    withName: 'INTERPROSCAN$' {
        publishDir = [ enabled: false ]
    }
    withName: 'DEEPLOC2$' {
        publishDir = [ enabled: false ]
    }
    withName: 'SIGNALP6$' {
        publishDir = [ enabled: false ]
    }
    withName: 'DEEPTMHMM$' {
        publishDir = [ enabled: false ]
    }
    withName: 'PHOBIUS$' {
        publishDir = [ enabled: false ]
    }

    // Same reasoning one level up: *_MERGE_BATCH (see splitForMerge in
    // workflows/rgaprofiler.nf) only exists for samples with too many chunks for one
    // merge task, and its partial, per-batch results would also tokenize to the tool's
    // publish directory and overwrite the final *_MERGE output there.
    withName: '.*_MERGE_BATCH' {
        publishDir = [ enabled: false ]
    }
    // A batch only covers some of the sample's chunks, so its merge must not require a
    // row for every FASTA record (the final PHOBIUS_MERGE still does).
    withName: 'PHOBIUS_MERGE_BATCH' {
        ext.partial = true
    }

}
