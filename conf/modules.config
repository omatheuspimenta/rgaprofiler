/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // The generic rule above derives a process's publish directory from only the *first*
    // underscore-token of its name (RGA_CLASSIFY and RGA_REPORT would otherwise both
    // resolve to "rga" and collide) -- RGA_REPORT needs its own explicit path per the
    // Stage 7 plan ("Published under ${params.outdir}/summary_report/").
    withName: 'RGA_REPORT' {
        publishDir = [
            path: { "${params.outdir}/summary_report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // DEEPCOIL2, INTERPROSCAN, DEEPLOC2, SIGNALP6 and DEEPTMHMM all now run once per
    // FASTA_QC chunk rather than once per sample (see workflows/rgaprofiler.nf), so
    // every chunk of the same sample shares the same meta.id and would otherwise all
    // publish as the identical filename under the generic rule above, repeatedly
    // overwriting each other. These per-chunk outputs are a pure intermediate --
    // disable publishing for them; each tool's own *_MERGE process (whose name also
    // tokenizes to the same first token, e.g. "DEEPCOIL2_MERGE" -> "deepcoil2", so it
    // lands at the exact same path the single unchunked process used to) publishes the
    // real, merged deliverable instead.
    withName: 'DEEPCOIL2$' {
        publishDir = [ enabled: false ]
    }
    withName: 'INTERPROSCAN$' {
        publishDir = [ enabled: false ]
    }
    withName: 'DEEPLOC2$' {
        publishDir = [ enabled: false ]
    }
    withName: 'SIGNALP6$' {
        publishDir = [ enabled: false ]
    }
    withName: 'DEEPTMHMM$' {
        publishDir = [ enabled: false ]
    }

}
