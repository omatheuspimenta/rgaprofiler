/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for real, full-scale proteomes
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/base.config's per-process TIME budgets (and the whole-input processes' memory) are
    sized for the tiny 4-sequence test subsample, not a real, full-size proteome -- slow
    steps like InterProScan or SignalP6 can need much longer on real data and would
    otherwise be killed for running "too long" and retried into the same wall.
    DeepCoil2, Phobius, InterProScan, DeepLoc2, SignalP6 and DeepTMHMM all run once per FASTA_QC
    chunk rather than once against the entire input FASTA (see workflows/rgaprofiler.nf),
    and carry their own per-chunk labels (process_medium_chunk / process_high_chunk) whose
    memory and CPUs conf/base.config sizes per task from the chunk and the live host --
    this file therefore only sets their time ceiling (fixed days, replacing base.config's
    per-chunk scaled limits -- which already grow with chunk size and CPU vs GPU). Raise --num_blocks (smaller
    chunks) rather than any memory ceiling if a chunk task is still getting OOM-killed on a
    very large proteome. DeepCoil2 in particular should never be run unchunked
    (--num_blocks 1) against a large real proteome.

    No config editing needed: just add `long_running` to your -profile list, e.g.
        nextflow run . -profile docker,long_running ...
        nextflow run . -profile docker,test_full,long_running ...

    If a single week still isn't enough for your data, or a task still gets OOM-killed
    (exit code 137) even after conf/base.config's automatic retry-with-doubled-memory,
    copy this file, raise the numbers below, and point at your copy with -c instead (see
    ORIENTATIONS.md). Watch actual peak_rss per task with `-with-trace` on your first
    real run and adjust if needed.
----------------------------------------------------------------------------------------
*/

process {
    withLabel:process_single      { time = { 1.d  * task.attempt } }
    withLabel:process_low         { time = { 2.d  * task.attempt }; memory = { 24.GB  * task.attempt } }
    // process_medium / process_high are for whole-input processes only -- in this pipeline
    // that is RGA_CLASSIFY (process_medium), whose measured peak on the full reference
    // proteome is ~2.8GB. The chunked tools (DeepCoil2, DeepLoc2, SignalP6, DeepTMHMM,
    // InterProScan) carry their own labels below and do NOT inherit these.
    withLabel:process_medium      { time = { 4.d  * task.attempt }; memory = { 16.GB  * task.attempt } }
    withLabel:process_high        { time = { 7.d  * task.attempt }; memory = { 100.GB * task.attempt } }
    withLabel:process_long        { time = { 10.d * task.attempt } }
    // Chunked tools: only the time ceiling is raised here. Their memory/cpus are NOT
    // overridden -- conf/base.config already sizes them per chunk (and per host), so a
    // fixed "whole proteome" memory value here would reintroduce the over-reservation
    // that starves everything else of RAM at high --num_blocks.
    withLabel:process_medium_chunk { time = { 4.d * task.attempt } }
    withLabel:process_high_chunk   { time = { 7.d * task.attempt } }
}
