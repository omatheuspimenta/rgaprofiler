nextflow_process {
    name "Test Process FASTA_QC"
    script "../main.nf"
    process "FASTA_QC"

    test("Should remove duplicates, replace invalid characters with X, and split into chunks") {
        when {
            process {
                """
                def dirty_fasta = file("\${workDir}/dirty.fasta")
                dirty_fasta.text = '''\\
                >Seq1
                MKV*LY
                >Seq2
                MKVLY
                >Seq1 duplicada
                MKVLY
                >Seq3_invalida
                MKV123LY
                >Seq4
                ACDEF
                '''.stripIndent()

                input[0] = [
                    [ id:'teste_qc', single_end:false ],
                    dirty_fasta
                ]
                input[1] = 2 
                """
            }
        }
        then {
            assert process.success
            
            // 
            // TESTE 1: Main file
            // 
            def out_fasta = process.out.fasta[0][1]
            assert file(out_fasta).exists()
            
            def linhas_completas = file(out_fasta).readLines()
            assert linhas_completas.contains(">Seq1")
            assert !linhas_completas.contains(">Seq1 duplicada")
            assert linhas_completas.contains(">Seq3_invalida")
            assert linhas_completas.contains("MKVXXXLY")
            assert linhas_completas.contains(">Seq4")
            
            //
            // TESTE 2: Chunk validation
            // 
            def chunks_strings = process.out.chunks[0][1]
            
            assert chunks_strings instanceof List
            assert chunks_strings.size() == 2
            
            def chunk_files = chunks_strings.collect { file(it) }.sort { it.name }
            
            def chunk1_lines = chunk_files[0].readLines()
            assert chunk1_lines.contains(">Seq1")
            assert chunk1_lines.contains(">Seq2")
            assert !chunk1_lines.contains(">Seq3_invalida")
            
            def chunk2_lines = chunk_files[1].readLines()
            assert chunk2_lines.contains(">Seq3_invalida")
            assert chunk2_lines.contains("MKVXXXLY")
            assert chunk2_lines.contains(">Seq4")
            
            assert snapshot(process.out).match()
        }
    }
}