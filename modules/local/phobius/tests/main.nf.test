nextflow_process {
    name "Test Process PHOBIUS"
    script "../main.nf"
    process "PHOBIUS"

    test("Run phobius - R570 subsample (see tests/testdata/README.md)") {
        when {
            process {
                """
                input[0] = [
                    [ id:'r570_subsample', single_end:false ],
                    file("\${projectDir}/tests/testdata/r570_subsample.fasta", checkIfExists: true)
                ]
                """
            }
        }
        then {
            assert process.success

            def phobius_out = process.out.predictions[0][1]
            assert file(phobius_out).exists()

            def linhas = file(phobius_out).readLines()
            assert linhas.size() == 5 // header + 4 sequences

            // SoffiXsponR570.7os1g018900.1.p is a known signal-peptide positive (see
            // tests/testdata/README.md / softwares/SignalP6/r570/) -- Phobius's short-format
            // TSV marks the SP column 'Y' for it.
            def sp_line = linhas.find { it.contains('SoffiXsponR570.7os1g018900.1.p') }
            assert sp_line != null
            assert sp_line =~ /\s+Y\s+/

            assert snapshot(process.out.versions).match()
        }
    }
}
